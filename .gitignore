# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.build-deps*/
/.tools/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.codex-temp-*/
/.analysis/
/.codex-remote-attachments/
/.codex-video-review/
/.openai/
/.pnpm-store/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/build/
/.wrangler/
/telegraph-media-site/
/android/.gradle/
/android/build/
/android/app/build/
**/__pycache__/
/outputs/
/work/
/studio/jobs/
/studio/tls/
/studio/__pycache__/
/studio/tools/*.part
/studio/tools/*.keystore
/studio/tools/output-signing.p12
/android/app/src/main/assets/output-signing.p12
/android/local.properties
/android/signing.properties
/android/signing/*.p12
/android/signing/*.jks

# Public, non-secret build metadata required by the Vite configuration.
# Keep every other file in these generated/tool-owned directories ignored.
!/.openai/
/.openai/*
!/.openai/hosting.json
!/build/
/build/*
!/build/sites-vite-plugin.ts

# Internal screenshot drafts may contain local test-session details. Publish
# only the reviewed, privacy-safe images referenced by the public changelog.
/release-assets/v0.6.0-review/*
!/release-assets/v0.6.0-review/01-split-bilesen-secimi-hq.png
!/release-assets/v0.6.0-review/02-temizlik-profilleri-ve-iyilestirmeler-hq.png
!/release-assets/v0.6.0-review/03-motor-2-ve-yerel-https-hq.png
!/release-assets/v0.6.0-review/04-yerel-ag-oturumlari-hq-blur.png
!/release-assets/v0.6.0-review/05-islem-gecmisi-hq.png
/release-assets/v0.6.0/04-yerel-ag-ve-islem-gecmisi.png
